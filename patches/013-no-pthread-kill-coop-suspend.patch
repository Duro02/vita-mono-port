+	/* PS Vita (__vita__): 内核无异步信号, pthread_kill 只处理 sig 0.
+	 * 混合挂起依赖解释器/托管代码中的协作式安全点轮询:
+	 * 被挂起线程稍后会自己停下, 这里假装送达成功, 让调用方进入
+	 * pending 集合等待自挂起. 信号经 vita_note_thread_signal 记到
+	 * shim 的表里, 目标在 sem/cond 等待的 10ms 量子超时后调
+	 * mono_threads_state_poll 自挂起 (见 vita-shim.c 可中断等待).
+	 * 若目标永久阻塞在未包装的 native 调用里, STW 会一直等
+	 * (届时再把该调用包进 blocking 区). */
+	vita_note_thread_signal (mono_thread_info_get_tid (info), signum);
+	result = 0;
 #endif
 
